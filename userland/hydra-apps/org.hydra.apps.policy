<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Written by Hydra: Hydra Apps installs and removes programs for everyone through
     /usr/local/libexec/hydra-apps-helper, which only handles the programs in its catalogue -->
<policyconfig>
  <vendor>Hydra</vendor>
  <action id="org.hydra.apps.manage">
    <description>Install or remove programs for everyone</description>
    <message>Hydra Apps needs an administrator's password to install or remove a program for everyone on this computer.</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/hydra-apps-helper</annotate>
  </action>
</policyconfig>
