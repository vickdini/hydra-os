#!/usr/bin/python3
# Written by Hydra: Hydra Apps, the place to get programs (like the Microsoft Store).
#   hydra-apps [--installed] [--install ID] [--remove ID] [--quit-when-done]
# The programs are listed in /usr/local/share/hydra-apps/catalogue.json (see its comment).
# - Windows programs are installed for the user, with Wine: the publisher's installer is
#   downloaded over HTTPS, checked against the SHA-256 checksum the catalogue records, and run
#   with its switches for an installation without questions (hydra-apps-wine); its start-menu
#   entry lands in "Windows Programs". Uninstall goes through hydra-wine-uninstall, the one
#   the start menu's right-click "Uninstall" uses.
# - Linux programs (Ubuntu packages, or a publisher's archive) are installed for everyone by
#   hydra-apps-helper, run as root through polkit (pkexec asks for an administrator's password).
# Every step is shown in the window in plain words; nothing needs a terminal.
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request

LIBEXEC = "/usr/local/libexec"
CATALOGUE = os.environ.get("HYDRA_APPS_CATALOGUE", "/usr/local/share/hydra-apps/catalogue.json")
WINE = "/opt/wine/bin/wine"
HOME = os.path.expanduser("~")
PREFIX = os.environ.get("WINEPREFIX", os.path.join(HOME, ".wine"))
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "hydra-apps")
WINE_MENU = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "applications", "wine")


def notify(title, body, icon="system-software-install"):
    subprocess.run(["gdbus", "call", "--session", "--timeout", "5", "--dest", "org.freedesktop.Notifications",
                    "--object-path", "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.Notify",
                    "Hydra Apps", "0", icon, title, body, "[]", "{}", "15000"], capture_output=True)


try:
    from PyQt6.QtCore import QEvent, QObject, QProcess, QSize, Qt, QThread, QTimer, pyqtSignal
    from PyQt6.QtGui import QFont, QIcon, QPalette
    from PyQt6.QtWidgets import (QApplication, QFrame, QGridLayout, QHBoxLayout, QLabel, QLineEdit, QListWidget,
                                 QListWidgetItem, QMainWindow, QMessageBox, QProgressBar, QPushButton, QScrollArea,
                                 QSizePolicy, QStackedWidget, QVBoxLayout, QWidget)
except ImportError:
    # Hydra installs PyQt6 at boot when it is missing (hydra-apps-helper ensure-base); if that
    # has not happened yet (no internet at the time), it is installed now
    if os.environ.get("HYDRA_APPS_BOOTSTRAP"):
        notify("Hydra Apps could not start", "A part it needs (PyQt6) could not be installed. Please check the internet connection.", "dialog-error")
        sys.exit(1)
    notify("Setting up Hydra Apps", "Hydra Apps needs one more part (about 20 MB). This takes a minute, only the first time.")
    r = subprocess.run(["pkexec", os.path.join(LIBEXEC, "hydra-apps-helper"), "ensure-base"], capture_output=True, text=True)
    if r.returncode != 0:
        err = [l[6:] for l in r.stdout.splitlines() if l.startswith("ERROR ")]
        notify("Hydra Apps could not be set up", err[-1] if err else "The administrator's password is needed the first time.", "dialog-error")
        sys.exit(1)
    os.environ["HYDRA_APPS_BOOTSTRAP"] = "1"
    os.execv(sys.executable, [sys.executable] + sys.argv)


