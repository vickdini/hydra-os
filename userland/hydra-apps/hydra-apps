# Work in the background


class Download(QThread):
    """Downloads an installer into the cache and checks its SHA-256."""
    progress = pyqtSignal(int, int)
    done = pyqtSignal(bool, str)

    def __init__(self, url, sha256, dest):
        super().__init__()
        self.url, self.sha256, self.dest = url, sha256, dest
        self.cancelled = False

    def run(self):
        if os.path.exists(self.dest):
            h = hashlib.sha256()
            with open(self.dest, "rb") as f:
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
            if h.hexdigest() == self.sha256:
                self.done.emit(True, "")
                return
        tmp = self.dest + ".part"
        h = hashlib.sha256()
        try:
            req = urllib.request.Request(self.url, headers={"User-Agent": "Hydra-Apps/1.0"})
            with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
                total = int(r.headers.get("Content-Length") or 0)
                got = 0
                while not self.cancelled:
                    chunk = r.read(1 << 16)
                    if not chunk:
                        break
                    f.write(chunk)
                    h.update(chunk)
                    got += len(chunk)
                    self.progress.emit(got, total)
        except Exception as e:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            self.done.emit(False, "The installer could not be downloaded. Please check that the computer is connected to the internet and try again.\n(%s)" % e)
            return
        if self.cancelled:
            os.unlink(tmp)
            self.done.emit(False, "Cancelled. Nothing was installed.")
            return
        if h.hexdigest() != self.sha256:
            os.unlink(tmp)
            self.done.emit(False, "The downloaded installer is not the one Hydra expected: it may have been damaged or changed on the publisher's site. For your safety it was not run, and nothing was installed.")
            return
        os.replace(tmp, self.dest)
        self.done.emit(True, "")


class Job(QObject):
    """Installs or removes one program; reports progress (percent, text) and the end (success,
    message)."""
    progress = pyqtSignal(int, str)
    finished = pyqtSignal(bool, str)

    def __init__(self, app, action):
        super().__init__()
        self.app, self.action = app, action
        self.proc = None
        self.dl = None
        self.err = ""
        self.buf = b""

    def start(self):
        a = self.app
        if a["kind"] == "windows":
            if self.action == "install":
                os.makedirs(CACHE, exist_ok=True)
                self.installer = os.path.join(CACHE, os.path.basename(a["url"]))
                self.progress.emit(0, "Downloading %s…" % a["name"])
                self.dl = Download(a["url"], a["sha256"], self.installer)
                self.dl.progress.connect(self._dl_progress)
                self.dl.done.connect(self._dl_done)
                self.dl.start()
            else:
                self._uninstall_windows()
        else:
            self.progress.emit(0, "Waiting for the administrator's password…")
            self._run("pkexec", [os.path.join(LIBEXEC, "hydra-apps-helper"), self.action, a["id"]])

    def cancel(self):
        if self.dl:
            self.dl.cancelled = True

    def _dl_progress(self, got, total):
        if total:
            self.progress.emit(int(50 * got / total), "Downloading %s… %d of %d MB" % (self.app["name"], got >> 20, max(1, total >> 20)))
        else:
            self.progress.emit(0, "Downloading %s… %d MB" % (self.app["name"], got >> 20))

    def _dl_done(self, ok, msg):
        if not ok:
            self.finished.emit(False, msg)
            return
        self.progress.emit(50, "Download checked. Starting the installer…")
        self._run(os.path.join(LIBEXEC, "hydra-apps-wine"), ["install", self.app["name"], self.installer] + self.app.get("silent", []))

    def _uninstall_windows(self):
        a = self.app
        entry = windows_menu_entry(a)
        if not entry:
            # hydra-wine-uninstall finds the program by the entry's folder and name: one made
            # for it, in a folder named after the program's name in Windows' list
            d = os.path.join(CACHE, "uninstall", a["registry"])
            os.makedirs(d, exist_ok=True)
            entry = os.path.join(d, "entry.desktop")
            unix = wine_unix_path(a.get("exe", "")) or ""
            with open(entry, "w", encoding="utf-8") as f:
                f.write("[Desktop Entry]\nType=Application\nName=%s\nPath=%s\n" % (a["registry"], os.path.dirname(unix)))
        self.progress.emit(30, "Uninstalling %s… If its uninstaller asks something, answer in its window." % a["name"])
        self._run(os.path.join(LIBEXEC, "hydra-wine-uninstall"), [entry])

    def _run(self, prog, args):
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self._read)
        self.proc.finished.connect(self._ended)
        self.proc.errorOccurred.connect(self._error)
        self.proc.start(prog, args)

    def _error(self, e):
        if e == QProcess.ProcessError.FailedToStart:
            self.finished.emit(False, "A part of Hydra Apps is missing (%s)." % self.proc.program())

    def _read(self):
        self.buf += bytes(self.proc.readAllStandardOutput())
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            line = line.decode("utf-8", "replace").strip()
            if line.startswith("PROGRESS "):
                parts = line.split(" ", 2)
                try:
                    self.progress.emit(int(parts[1]), parts[2] if len(parts) > 2 else "")
                except ValueError:
                    pass
            elif line.startswith("ERROR "):
                self.err = line[6:]

    def _ended(self, code, status):
        a = self.app
        prog = os.path.basename(self.proc.program())
        if prog == "pkexec" and code in (126, 127) and not self.err:
            self.finished.emit(False, "The administrator's password was not given, so nothing was changed.")
            return
        if a["kind"] == "windows" and self.action == "install":
            self._windows_installed(code)
            return
        if a["kind"] == "windows":
            gone = not any(n.lower().startswith(a["registry"].lower()) for n in windows_installed_names())
            self.finished.emit(gone, "%s was uninstalled." % a["name"] if gone else
                               "%s is still installed: its uninstaller did not finish." % a["name"])
            return
        if code != 0:
            self.finished.emit(False, self.err or "Something went wrong (code %d). Details are in /var/log/hydra-apps.log." % code)
            return
        # The start menu's list of programs
        subprocess.Popen(["kbuildsycoca6"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if self.action == "install":
            self.finished.emit(True, "%s is installed. You find it in the start menu, or open it here." % a["name"])
        else:
            self.finished.emit(True, "%s was removed." % a["name"])

    def _windows_installed(self, code, tries=0):
        a = self.app
        if not any(n.lower().startswith(a["registry"].lower()) for n in windows_installed_names()):
            # Wine writes its registry to disk every 30 seconds: give it the time
            if tries < 16:
                self.progress.emit(97, "Finishing…")
                QTimer.singleShot(3000, lambda: self._windows_installed(code, tries + 1))
                return
            self.finished.emit(False, self.err or "The installer of %s ended without installing it (code %d). Details are in %s."
                               % (a["name"], code, os.path.join(HOME, ".cache/hydra-wine")))
            return
        if not windows_menu_entry(a):
            make_menu_entry(a)
            subprocess.run(["/bin/sh", "-c",
                            ". %s/hydra-wine-common; add_uninstall_actions; kbuildsycoca6 >/dev/null 2>&1" % LIBEXEC],
                           capture_output=True)
        self.finished.emit(True, "%s is installed. You find it in the start menu under Windows Programs, or open it here." % a["name"])


