# What is installed


def load_catalogue():
    with open(CATALOGUE, encoding="utf-8") as f:
        data = json.load(f)
    return data.get("categories", []), data["apps"]


def windows_installed_names():
    """DisplayName of every program in Windows' list of installed programs (the Uninstall keys
    of the machine's and the user's registry)."""
    names = []
    for reg in ("system.reg", "user.reg"):
        try:
            with open(os.path.join(PREFIX, reg), encoding="utf-8", errors="replace") as f:
                section = False
                for line in f:
                    if line.startswith("["):
                        section = "\\\\Uninstall\\\\" in line
                    elif section and line.startswith('"DisplayName"="'):
                        names.append(line.rstrip("\n")[15:-1])
        except OSError:
            pass
    return names


def apt_status(packages):
    if not packages:
        return {}
    r = subprocess.run(["dpkg-query", "-W", "-f=${Package} ${db:Status-Status}\n"] + packages, capture_output=True, text=True)
    return {l.split()[0]: l.split()[1] for l in r.stdout.splitlines() if len(l.split()) == 2}


def find_desktop(name):
    for d in (os.path.join(HOME, ".local/share/applications"), "/usr/local/share/applications", "/usr/share/applications"):
        p = os.path.join(d, name)
        if os.path.exists(p):
            return p
    return None


def wine_unix_path(win):
    """C:\\Program Files\\X\\x.exe -> <prefix>/drive_c/Program Files/X/x.exe"""
    if len(win) > 2 and win[1] == ":":
        return os.path.join(PREFIX, "drive_c" if win[0].lower() == "c" else "dosdevices/" + win[0].lower() + ":",
                            win[3:].replace("\\", "/"))
    return None


def desktop_value(path, key):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith(key + "="):
                    return line[len(key) + 1:].rstrip("\n")
    except OSError:
        pass
    return None


def wine_menu_entries():
    found = []
    for root, _, files in os.walk(WINE_MENU):
        found += [os.path.join(root, f) for f in files if f.endswith(".desktop")]
    return found


def windows_menu_entry(app):
    """The start-menu entry of a Windows program: the one named like it (or like its main
    shortcut), else one that starts a program in its folder."""
    wanted = {app["name"].lower(), app.get("menu_name", app["name"]).lower()}
    folder = os.path.dirname(wine_unix_path(app["exe"]) or "") if app.get("exe") else ""
    by_path = None
    for e in sorted(wine_menu_entries()):
        if "uninstall" in os.path.basename(e).lower():
            continue
        n = (desktop_value(e, "Name") or "").lower()
        if n in wanted:
            return e
        if folder and (desktop_value(e, "Path") or "") == folder and by_path is None:
            by_path = e
    return by_path


def make_menu_entry(app):
    """A start-menu entry for a Windows program whose installer made none (in the "Windows
    Programs" folder, like the ones Wine writes)."""
    exe = app.get("exe")
    unix = wine_unix_path(exe) if exe else None
    if not unix or not os.path.exists(unix):
        return None
    d = os.path.join(WINE_MENU, "Programs")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, re.sub(r"[^A-Za-z0-9 +._-]", "", app["name"]) + ".desktop")
    # The Exec line's quoting: each backslash of the Windows path is written four times
    arg = exe.replace("\\", "\\\\\\\\")
    with open(path, "w", encoding="utf-8") as f:
        f.write("[Desktop Entry]\n# Written by Hydra Apps\nType=Application\nName=%s\nComment=%s\n"
                "Exec=env WINEPREFIX=\"%s\" %s \"%s\"\nPath=%s\nIcon=%s\nTerminal=false\nCategories=Wine;\n"
                % (app["name"], app["summary"], PREFIX, WINE, arg, os.path.dirname(unix), app["icon"][0]))
    return path


def theme_icon(names):
    for n in names:
        if QIcon.hasThemeIcon(n):
            return QIcon.fromTheme(n)
    return QIcon.fromTheme("application-x-executable")


