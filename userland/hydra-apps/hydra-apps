        self.grid = QGridLayout()
        self.grid.setSpacing(12)
        self.listlay.addLayout(self.grid)
        self.listlay.addStretch(1)
        scroll.setWidget(self.listw)
        self.pages.addWidget(scroll)
        self.details = Details(self)
        self.pages.addWidget(self.details)

        # A line at the bottom while something is being installed
        self.footer = QFrame()
        self.footer.setObjectName("footer")
        fl = QHBoxLayout(self.footer)
        fl.setContentsMargins(24, 8, 24, 8)
        self.footer_text = QLabel()
        fl.addWidget(self.footer_text, 1)
        self.footer_bar = QProgressBar()
        self.footer_bar.setRange(0, 100)
        self.footer_bar.setFixedWidth(220)
        fl.addWidget(self.footer_bar)
        self.footer.hide()
        right.addWidget(self.footer)

        self.scroll = scroll
        scroll.viewport().installEventFilter(self)
        self.cards = []
        self.refresh_state()
        self.nav.setCurrentRow(1 if opts.get("installed") else 0)
        # The state changes outside the window too (start-menu "Uninstall", the terminal)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.timer.start(5000)
        if opts.get("install") or opts.get("remove"):
            app = self.by_id(opts.get("install") or opts.get("remove"))
            if app:
                self.show_details(app)
                QTimer.singleShot(500, lambda: self.start_job(app, "install" if opts.get("install") else "remove"))

    def eventFilter(self, obj, e):
        # The list is as wide as its view: cards wrap their text rather than run off the side
        if obj is self.scroll.viewport() and e.type() == QEvent.Type.Resize:
            self.listw.setMaximumWidth(e.size().width())
        return False

    def by_id(self, i):
        return next((a for a in self.apps if a["id"] == i), None)

    def kind_text(self, app):
        return {"windows": "Windows program", "apt": "Linux app", "tarball": "Linux app"}[app["kind"]] + " · " + app["category"]

    def available(self, app):
        return app["kind"] != "windows" or os.path.exists(WINE)

    def is_installed(self, app):
        return self.state.get(app["id"], False)

    def refresh_state(self):
        apt = apt_status([a["check"] for a in self.apps if a["kind"] == "apt"])
        wn = [n.lower() for n in windows_installed_names()]
        st = {}
        for a in self.apps:
            if a["kind"] == "apt":
                st[a["id"]] = apt.get(a["check"]) == "installed"
            elif a["kind"] == "tarball":
                st[a["id"]] = os.path.exists(os.path.join("/opt", a["dir"], a["binary"]))
            else:
                st[a["id"]] = any(n.startswith(a["registry"].lower()) for n in wn)
        changed = st != self.state
        self.state = st
        return changed

    def poll(self):
        if self.job is None and self.refresh_state():
            self.update_cards()
            self.details.refresh()

    def show_list(self):
        self.pages.setCurrentIndex(0)
        row = self.nav.currentRow()
        text = self.search.text().strip().lower()
        if row == 0:
            self.title.setText("All apps")
            self.intro.setText("Programs you may know from Windows, and free Linux apps for everyday needs. Windows programs "
                               "are installed for you and run with Hydra's Windows support; Linux apps are installed for "
                               "everyone on this computer and need an administrator's password.")
        elif row == 1:
            self.title.setText("Installed")
            self.intro.setText("Programs from Hydra Apps on this computer. Windows programs you installed yourself are in "
                               "the start menu under Windows Programs (right-click one to uninstall it).")
        else:
            self.title.setText(self.categories[row - 2])
            self.intro.setText("")
        shown = []
        for a in self.apps:
            if row == 1 and not self.is_installed(a):
                continue
            if row >= 2 and a["category"] != self.categories[row - 2]:
                continue
            if text and text not in (a["name"] + " " + a["summary"] + " " + a["category"] + " " + a.get("publisher", "")).lower():
                continue
            shown.append(a)
        for c in self.cards:
            c.setParent(None)
            c.deleteLater()
        self.cards = []
        for i, a in enumerate(shown):
            c = Card(a, self)
            c.clicked.connect(self.show_details)
            self.grid.addWidget(c, i // 2, i % 2)
            self.cards.append(c)
        if not shown:
            empty = QLabel("Nothing installed from Hydra Apps yet." if row == 1 and not text else "No app matches your search.")
            empty.setObjectName("dim")
            empty.setAlignment(Qt.AlignmentFlag.AlignCenter)
            empty.setMinimumHeight(120)
            self.grid.addWidget(empty, 0, 0, 1, 2)
            self.cards.append(empty)
        self.update_cards()

    def update_cards(self):
        for c in self.cards:
            if not isinstance(c, Card):
                continue
            a = c.app
            if self.job and self.job.app is a:
                c.button.setText("%d %%" % self.job_pct)
                c.button.setEnabled(False)
            elif self.is_installed(a):
                c.button.setText("Open")
                c.button.setEnabled(True)
            else:
                c.button.setText("Install" if self.available(a) else "Unavailable")
                c.button.setEnabled(self.job is None and self.available(a))

    def show_details(self, app):
        self.details.show_app(app)
        self.pages.setCurrentIndex(1)

    def primary_action(self, app):
        if self.is_installed(app):
            self.open_app(app)
        else:
            self.show_details(app)
            self.start_job(app, "install")

    def open_app(self, app):
        if app["kind"] == "windows":
            entry = windows_menu_entry(app)
            if entry:
                subprocess.Popen(["kioclient", "exec", entry], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                subprocess.Popen([WINE, app["exe"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        else:
            entry = find_desktop(app["desktop"])
            if entry:
                subprocess.Popen(["kioclient", "exec", entry], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def confirm_remove(self, app):
        extra = (" It is removed for everyone on this computer." if app["kind"] != "windows" else
                 " Its own uninstaller may ask whether to keep your settings.")
        r = QMessageBox.question(self, "Uninstall %s?" % app["name"], "Uninstall %s?%s" % (app["name"], extra))
        if r == QMessageBox.StandardButton.Yes:
            self.start_job(app, "remove")

    def start_job(self, app, action):
        if self.job is not None or not self.available(app):
            return
        self.results.pop(app["id"], None)
        self.job = Job(app, action)
        self.job.progress.connect(self.job_progress)
        self.job.finished.connect(self.job_finished)
        self.job_pct, self.job_text = 0, ("Installing %s…" if action == "install" else "Uninstalling %s…") % app["name"]
        self.footer.show()
        self.job_progress(0, self.job_text)
        self.job.start()

    def cancel_job(self):
        if self.job:
            self.job.cancel()

    def job_progress(self, pct, text):
        self.job_pct, self.job_text = pct, text or self.job_text
        self.footer_text.setText(self.job_text)
        self.footer_bar.setValue(pct)
        self.update_cards()
        self.details.refresh()

    def job_finished(self, ok, msg):
        app = self.job.app
        self.job.deleteLater()
        self.job = None
        self.footer.hide()
        self.results[app["id"]] = msg
        self.refresh_state()
        self.show_list() if self.pages.currentIndex() == 0 else self.update_cards()
        self.details.refresh()
        print("HYDRA_APPS_RESULT", app["id"], "ok" if ok else "failed", msg, flush=True)
        if not ok:
            QMessageBox.warning(self, "%s" % app["name"], msg) if not self.opts.get("quit") else None
        elif not self.isActiveWindow():
            notify(msg.split(".")[0] + ".", "", "dialog-ok")
        if self.opts.get("quit"):
            QApplication.instance().exit(0 if ok else 1)


STYLE = """
QFrame#card { background: palette(base); border: 1px solid palette(midlight); border-radius: 8px; }
QFrame#card:hover { border: 1px solid palette(highlight); }
QListWidget#nav { background: palette(window); padding-top: 12px; }
QListWidget#nav::item { border-radius: 6px; margin: 1px 8px; padding-left: 6px; color: palette(text); }
QListWidget#nav::item:selected { background: palette(highlight); color: palette(highlighted-text); }
QFrame#footer { border-top: 1px solid palette(midlight); }
QLabel#dim { color: palette(placeholder-text); }
"""


def main():
    opts = {}
    args = sys.argv[1:]
    while args:
        a = args.pop(0)
        if a == "--installed":
            opts["installed"] = True
        elif a in ("--install", "--remove") and args:
            opts[a[2:]] = args.pop(0)
        elif a == "--quit-when-done":
            opts["quit"] = True
    app = QApplication(sys.argv[:1])
    app.setApplicationName("hydra-apps")
    app.setApplicationDisplayName("Hydra Apps")
    app.setDesktopFileName("org.hydra.apps")
    app.setStyleSheet(STYLE)
    w = Window(opts)
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
