class Card(QFrame):
    """One program in the list: icon, name, one line about it, and its button."""
    clicked = pyqtSignal(dict)

    def __init__(self, app, window):
        super().__init__()
        self.app, self.window = app, window
        self.setObjectName("card")
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setMinimumHeight(118)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(14, 12, 14, 12)
        lay.setSpacing(14)
        icon = QLabel()
        icon.setPixmap(theme_icon(app["icon"]).pixmap(QSize(56, 56)))
        icon.setAlignment(Qt.AlignmentFlag.AlignTop)
        lay.addWidget(icon)
        col = QVBoxLayout()
        col.setSpacing(3)
        name = QLabel(app["name"])
        f = name.font()
        f.setPointSizeF(f.pointSizeF() * 1.15)
        f.setBold(True)
        name.setFont(f)
        col.addWidget(name)
        kind = QLabel(window.kind_text(app))
        kind.setObjectName("dim")
        col.addWidget(kind)
        summary = QLabel(app["summary"])
        summary.setWordWrap(True)
        summary.setMinimumWidth(60)
        name.setMinimumWidth(60)
        col.addWidget(summary)
        col.addStretch(1)
        lay.addLayout(col, 1)
        self.button = QPushButton()
        self.button.setMinimumWidth(96)
        self.button.clicked.connect(lambda: window.primary_action(app))
        lay.addWidget(self.button, 0, Qt.AlignmentFlag.AlignVCenter)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self.clicked.emit(self.app)


class Details(QWidget):
    """A program's page: what it is, Install / Open / Uninstall, and the progress."""

    def __init__(self, window):
        super().__init__()
        self.window = window
        self.app = None
        outer = QVBoxLayout(self)
        outer.setContentsMargins(24, 16, 24, 16)
        back = QPushButton(QIcon.fromTheme("go-previous"), "Back")
        back.setFlat(True)
        back.clicked.connect(window.show_list)
        outer.addWidget(back, 0, Qt.AlignmentFlag.AlignLeft)
        head = QHBoxLayout()
        head.setSpacing(20)
        self.icon = QLabel()
        head.addWidget(self.icon, 0, Qt.AlignmentFlag.AlignTop)
        col = QVBoxLayout()
        self.name = QLabel()
        f = self.name.font()
        f.setPointSizeF(f.pointSizeF() * 1.8)
        f.setBold(True)
        self.name.setFont(f)
        col.addWidget(self.name)
        self.sub = QLabel()
        self.sub.setObjectName("dim")
        col.addWidget(self.sub)
        buttons = QHBoxLayout()
        self.install = QPushButton(QIcon.fromTheme("download"), "Install")
        self.open = QPushButton(QIcon.fromTheme("media-playback-start"), "Open")
        self.remove = QPushButton(QIcon.fromTheme("edit-delete"), "Uninstall")
        self.cancel = QPushButton("Cancel")
        for b in (self.install, self.open, self.remove, self.cancel):
            b.setMinimumWidth(110)
            buttons.addWidget(b)
        buttons.addStretch(1)
        self.install.clicked.connect(lambda: window.start_job(self.app, "install"))
        self.open.clicked.connect(lambda: window.open_app(self.app))
        self.remove.clicked.connect(lambda: window.confirm_remove(self.app))
        self.cancel.clicked.connect(window.cancel_job)
        col.addSpacing(8)
        col.addLayout(buttons)
        head.addLayout(col, 1)
        outer.addLayout(head)
        self.bar = QProgressBar()
        self.bar.setRange(0, 100)
        outer.addWidget(self.bar)
        self.status = QLabel()
        self.status.setWordWrap(True)
        outer.addWidget(self.status)
        outer.addSpacing(12)
        self.desc = QLabel()
        self.desc.setWordWrap(True)
        self.desc.setAlignment(Qt.AlignmentFlag.AlignTop)
        self.desc.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        outer.addWidget(self.desc)
        self.facts = QLabel()
        self.facts.setObjectName("dim")
        self.facts.setWordWrap(True)
        outer.addWidget(self.facts)
        outer.addStretch(1)

    def show_app(self, app):
        self.app = app
        self.icon.setPixmap(theme_icon(app["icon"]).pixmap(QSize(96, 96)))
        self.name.setText(app["name"])
        self.sub.setText("%s · %s" % (app.get("publisher", ""), app["category"]))
        self.desc.setText(app["description"])
        how = {"windows": "A Windows program. It is installed for you (your user account) and runs with Hydra's Windows support. "
                          "The installer comes straight from the publisher's website and is checked before it runs.",
               "apt": "A Linux app from Ubuntu, installed for everyone on this computer. It needs an administrator's password.",
               "tarball": "A Linux app from the publisher's website, installed for everyone on this computer. It needs an administrator's password."}
        self.facts.setText("%s\nDownload size: about %d MB." % (how[app["kind"]], app.get("size_mb", 0)))
        self.refresh()

    def refresh(self):
        if not self.app:
            return
        w = self.window
        busy = w.job is not None
        mine = busy and w.job.app is self.app
        inst = w.is_installed(self.app)
        usable = w.available(self.app)
        self.install.setVisible(not inst and not mine)
        self.install.setEnabled(not busy and usable)
        self.open.setVisible(inst)
        self.open.setEnabled(not mine)
        self.remove.setVisible(inst)
        self.remove.setEnabled(not busy)
        self.cancel.setVisible(mine and w.job.dl is not None and w.job.proc is None)
        self.bar.setVisible(mine)
        if mine:
            self.bar.setValue(w.job_pct)
            self.status.setText(w.job_text)
        elif self.app["id"] in w.results:
            self.status.setText(w.results[self.app["id"]])
        elif not usable:
            self.status.setText("Windows support (Wine) is not installed on this computer.")
        elif busy:
            self.status.setText("Please wait until %s is finished." % w.job.app["name"])
        else:
            self.status.setText("Installed." if inst else "")


