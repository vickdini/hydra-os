#!/bin/sh
# Written by Hydra: "Uninstall" in the right-click menu of a Windows program's start-menu entry.
#   hydra-wine-uninstall ENTRY.desktop
# Finds the program's entry in Windows' list of installed programs (the registry's Uninstall
# keys: the one whose uninstaller, folder or icon lies in the folder the menu entry starts the
# program in, else the one named like the entry's start-menu folder or the entry) and runs its
# own uninstaller, as Settings > Apps does on Windows. When no entry
# matches, Windows' "Add or remove programs" list opens so the person can pick it there.
. /usr/local/libexec/hydra-wine-common
d="$1"
name=$(sed -n 's/^Name=//p' "$d" | head -n 1)
dir=$(sed -n 's/^Path=//p' "$d" | head -n 1)
wait_for_setup "The uninstaller" || exit 1

# find_key dir|name WANTED: the name of the first Uninstall key in Windows' list of installed
# programs that has a value naming a file in folder WANTED (or the folder itself), or whose
# DisplayName starts with WANTED; lower case, folders with forward slashes. 64-bit programs'
# keys come first in the file, then 32-bit ones (Wow6432Node). Each run of backslashes
# becomes one slash first (tr): the file doubles them, and awks disagree on backslashes in
# patterns
find_key() {
    tr -s '\\' '/' < "$P/system.reg" | MODE="$1" WANT="$2" awk '
        { l = $0 }
        l ~ /^\[/ {
            k = ""
            if (match(l, /^\[Software\/(Wow6432Node\/)?Microsoft\/Windows\/CurrentVersion\/Uninstall\//)) {
                k = substr(l, RLENGTH + 1)
                sub(/\] [0-9]+$/, "", k)
                sub(/\]$/, "", k)
            }
            next
        }
        k == "" { next }
        ENVIRON["MODE"] == "dir" && l ~ /^"(UninstallString|InstallLocation|DisplayIcon|QuietUninstallString)"=/ {
            v = tolower(l)
            if (index(v, ENVIRON["WANT"] "/") || index(v, ENVIRON["WANT"] "\"")) { print k; exit }
        }
        ENVIRON["MODE"] == "name" && l ~ /^"DisplayName"="/ {
            if (index(tolower(l), "\"displayname\"=\"" ENVIRON["WANT"]) == 1) { print k; exit }
        }
        ENVIRON["MODE"] == "title" && k == ENVIRON["WANT"] && l ~ /^"DisplayName"="/ {
            sub(/^"DisplayName"="/, "", l)
            sub(/"$/, "", l)
            print l
            exit
        }'
}

# The folder the menu entry starts the program in, as Windows names it, lower case with
# forward slashes: /home/u/.wine/drive_c/Program Files/X -> c:/program files/x
win=
case "$dir" in
"$P/drive_c/"*) win="c:/${dir#"$P/drive_c/"}" ;;
"$P/dosdevices/"?:/*) win="${dir#"$P/dosdevices/"}" ;;
esac
win=$(printf '%s' "$win" | tr 'A-Z' 'a-z' | sed 's#/*$##')
# Entries without a folder (7-Zip's) are matched by name: their start-menu folder's (usually
# the product's), then their own, against the start of the installed programs' names
folder=$(basename "$(dirname "$d")")
case "$folder" in Programs|wine|applications) folder= ;; esac
key=
[ -n "$win" ] && key=$(find_key dir "$win")
for n in "$folder" "$name"; do
    [ -z "$key" ] && [ ${#n} -ge 3 ] && key=$(find_key name "$(printf '%s' "$n" | tr 'A-Z' 'a-z')")
done

if [ -z "$key" ]; then
    notify "Choose the program to uninstall" "Hydra could not tell which installed program \"$name\" belongs to. Pick it in the list."
    exec "$WINE" uninstaller
fi
# The installed program's own name for the message ("7-Zip 24.09", not "7-Zip File Manager")
title=$(find_key title "$key")
[ -n "$title" ] && name="$title"
"$WINE" uninstaller --remove "$key" > "$CACHE/uninstall.log" 2>&1

# The program's uninstaller often keeps running after Wine's returns (it copies itself to a
# temporary folder first). Once the key is gone, start-menu entries whose Windows shortcut
# went with it are removed too (Wine's own clean-up); give up after half an hour
n=0
while [ $n -lt 360 ]; do
    grep -q -F "Uninstall\\\\$key]" "$P/system.reg" || break
    sleep 5
    n=$((n + 1))
done
# Uninstallers remove the key before they finish (Notepad++'s then asks whether to keep the
# settings): the message waits for them, for up to 10 minutes. They run from a copy in a
# temporary folder (NSIS: Un_A.exe or Au_.exe, others uninstall.exe, unins000.exe)
n=0
while [ $n -lt 300 ] && ps -eo args= | grep -i -q -e 'un_a\.exe' -e 'au_\.exe' -e 'uninst[a-z0-9]*\.exe' -e 'unins[0-9]*\.exe'; do
    sleep 2
    n=$((n + 1))
done
WINEDEBUG=-all "$WINE" winemenubuilder -r > /dev/null 2>&1
kbuildsycoca6 > /dev/null 2>&1
if grep -q -F "Uninstall\\\\$key]" "$P/system.reg"; then
    exit 1
fi
notify "$name was uninstalled" "It has been removed from this computer." edit-delete
