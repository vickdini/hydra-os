#!/bin/sh
# Written by Hydra: prepares the user's Windows environment (Wine prefix) at first login, adds
# Wine Mono (.NET programs) from Wine's shared copy when the prefix does not have it, and keeps
# Hydra's settings in it
. /usr/local/libexec/hydra-wine-common
M=$(ls -d /opt/wine/share/wine/mono/wine-mono-* 2>/dev/null | tail -n 1)
has_mono() { grep -q '"DisplayName"="Wine Mono Windows Support"' "$P/system.reg" 2>/dev/null; }
# Keyboard focus: with Wine's default (WM_TAKE_FOCUS) KWin activates a new window but leaves
# the keyboard on nothing until the program answers, and a program still starting up (Notepad++
# right after its installer's Finish) loses what is typed meanwhile, for seconds. With this the
# window manager gives the window the keyboard itself, and the keys wait in the program's queue
has_focus() { grep -q '"UseTakeFocus"="N"' "$P/user.reg" 2>/dev/null; }
add_uninstall_actions
[ -f "$P/system.reg" ] && { [ -z "$M" ] || has_mono; } && has_focus && exit 0
LOCK="$HOME/.cache/hydra-wine-setup.lock"
# One setup at a time; a lock left behind by a computer switched off during the setup (its
# process is gone) is removed by setup_busy
setup_busy && exit 0
mkdir "$LOCK" 2>/dev/null || exit 0
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT
# Wine without a window, and without the questions about Mono and Gecko
quiet() {
    o="$1"
    shift
    env -u DISPLAY WAYLAND_DISPLAY=hydra-no-display WINEDEBUG=-all WINEDLLOVERRIDES="$o" nice -n 10 "$@" >/dev/null 2>&1 \
        && /opt/wine/bin/wineserver -w
}
if [ ! -f "$P/system.reg" ]; then
    sleep 20
    notify "Preparing Windows support" "Windows programs will be ready in a few minutes. You can keep working."
    if ! quiet "mscoree,mshtml=" /opt/wine/bin/wineboot -i; then
        notify "Windows support could not be prepared" "It will be tried again at your next login."
        rm -rf "$P"
        exit 1
    fi
    # The desktop portal asks which program opens a file until one was chosen 3 times in a
    # row: record the Windows Program Loader as chosen (a host app's id is empty)
    for t in application/vnd.microsoft.portable-executable application/x-ms-dos-executable \
        application/x-msdownload application/x-msi application/x-ms-shortcut; do
        gdbus call --session --dest org.freedesktop.impl.portal.PermissionStore \
            --object-path /org/freedesktop/impl/portal/PermissionStore \
            --method org.freedesktop.impl.portal.PermissionStore.SetPermission \
            desktop-used-apps true "$t" "" "['wine', '3', '3']" >/dev/null 2>&1
    done
    has_focus || quiet "" /opt/wine/bin/wine reg add 'HKCU\Software\Wine\X11 Driver' /v UseTakeFocus /d N /f
    notify "Windows support is ready" "Open a Windows program (.exe or .msi) with a double-click."
fi
has_focus || quiet "" /opt/wine/bin/wine reg add 'HKCU\Software\Wine\X11 Driver' /v UseTakeFocus /d N /f
# Wine Mono: Wine's own installer for it, the package Wine runs for a shared copy
if [ -n "$M" ] && ! has_mono; then
    quiet "mshtml=" /opt/wine/bin/wine msiexec /i "Z:$M/support/winemono-support.msi" /qn
fi
