<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Written by Hydra: the Hydra installer (hydra-install) erases the chosen disk and installs
     Hydra on it through /usr/libexec/hydra-install-helper. In the live system the user "live"
     may do this without a password (60-hydra-install.rules); everyone else needs an
     administrator's password -->
<policyconfig>
  <vendor>Hydra</vendor>
  <action id="org.hydra.install.run">
    <description>Install Hydra on a disk</description>
    <message>Installing Hydra erases the chosen disk. An administrator's password is needed.</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/hydra-install-helper</annotate>
  </action>
</policyconfig>
