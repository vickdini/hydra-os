def human(n):
    for unit in ("bytes", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return ("%d %s" if unit == "bytes" else "%.0f %s" if n >= 100 else "%.1f %s") % (n, unit)
        n /= 1000.0


def hash_password(password):
    """crypt(3) yescrypt hash of PASSWORD (libxcrypt, the library /etc/shadow's tools use)."""
    lib = ctypes.CDLL("libcrypt.so.1")
    lib.crypt_gensalt.restype = ctypes.c_char_p
    lib.crypt_gensalt.argtypes = [ctypes.c_char_p, ctypes.c_ulong, ctypes.c_char_p, ctypes.c_int]
    lib.crypt.restype = ctypes.c_char_p
    lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    salt = lib.crypt_gensalt(b"$y$", 0, None, 0)
    if not salt:
        raise RuntimeError("no salt")
    h = lib.crypt(password.encode(), salt)
    if not h or not h.startswith(b"$y$"):
        raise RuntimeError("hashing failed")
    return h.decode()


def keyboard_layouts():
    """[(layout, description)] and {layout: [(variant, description)]} from xkb's list."""
    layouts, variants, sect = [], {}, None
    try:
        with open("/usr/share/X11/xkb/rules/evdev.lst", encoding="utf-8") as f:
            for line in f:
                if line.startswith("!"):
                    sect = line[1:].strip()
                    continue
                line = line.strip()
                if not line:
                    continue
                if sect == "layout":
                    name, _, desc = line.partition(" ")
                    layouts.append((name, desc.strip()))
                elif sect == "variant":
                    name, _, rest = line.partition(" ")
                    lay, _, desc = rest.strip().partition(":")
                    variants.setdefault(lay.strip(), []).append((name, desc.strip()))
    except OSError:
        layouts = [(l[2], l[0]) for l in LANGUAGES]
    layouts.sort(key=lambda x: x[1].lower())
    return layouts, variants


def time_zones():
    zones = []
    for tab in ("/usr/share/zoneinfo/tzdata.zi",):
        pass
    try:
        with open("/usr/share/zoneinfo/zone1970.tab", encoding="utf-8") as f:
            for line in f:
                if line.startswith("#"):
                    continue
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 3:
                    zones.append(parts[2])
    except OSError:
        pass
    for extra in ("Europe/Vienna", "Europe/Zurich", "Europe/Copenhagen", "Europe/Oslo", "Europe/Stockholm",
                  "Europe/Amsterdam", "Europe/Luxembourg", "Europe/Brussels", "UTC"):
        if extra not in zones and os.path.exists("/usr/share/zoneinfo/" + extra):
            zones.append(extra)
    return sorted(set(zones))


def live_timezone():
    try:
        with open("/etc/timezone") as f:
            tz = f.read().strip()
    except OSError:
        tz = ""
    if not tz:
        try:
            tz = os.path.realpath("/etc/localtime").split("/zoneinfo/", 1)[1]
        except (IndexError, OSError):
            tz = ""
    return "" if tz in ("", "UTC", "Etc/UTC", "Etc/Universal") else tz


def reserved_names():
    try:
        return {p.pw_name for p in pwd.getpwall()} | {"root", "live", "admin", "hydra-setup"}
    except Exception:
        return {"root", "live", "admin"}


def suggest_user(full):
    import unicodedata
    first = (full.strip().split() or [""])[0]
    s = unicodedata.normalize("NFKD", first).encode("ascii", "ignore").decode().lower()
    s = re.sub(r"[^a-z0-9_-]", "", s)
    if s and not s[0].isalpha():
        s = "u" + s
    return s[:32]


