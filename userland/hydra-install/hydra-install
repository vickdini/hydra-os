class DiskPage(Page):
    def __init__(self, wiz):
        super().__init__(wiz)
        self.box.addWidget(title("Where should Hydra be installed?"))
        self.box.addWidget(para("Choose the disk. Hydra uses the <b>whole disk</b>: everything on it is deleted, "
                                "including Windows and your files on it. Copy what you want to keep to another "
                                "disk or a USB stick first."))
        self.list = QListWidget()
        self.list.setIconSize(QSize(40, 40))
        self.list.setSpacing(3)
        self.list.currentItemChanged.connect(self.changed)
        self.box.addWidget(self.list, 1)
        row = QHBoxLayout()
        self.info = para("", dim=True)
        row.addWidget(self.info, 1)
        refresh = QPushButton(QIcon.fromTheme("view-refresh"), "Look for disks again")
        refresh.clicked.connect(self.load)
        row.addWidget(refresh)
        self.box.addLayout(row)
        self.warn = QFrame()
        self.warn.setObjectName("danger")
        w = QVBoxLayout(self.warn)
        self.warn_text = QLabel()
        self.warn_text.setWordWrap(True)
        self.warn_text.setObjectName("dangertext")
        w.addWidget(self.warn_text)
        self.confirm = QCheckBox("I understand that everything on this disk will be deleted.")
        self.confirm.toggled.connect(self.wiz.update_buttons)
        w.addWidget(self.confirm)
        self.box.addWidget(self.warn)
        self.warn.hide()
        self.disks = []
        self.loaded = False

    def enter(self):
        if not self.loaded:
            self.load()

    def load(self):
        self.loaded = True
        self.list.clear()
        self.confirm.setChecked(False)
        try:
            env = dict(os.environ)
            r = subprocess.run([sys.executable, HELPER, "list-disks"] if HELPER.endswith(".py") else [HELPER, "list-disks"],
                               capture_output=True, text=True, timeout=60, env=env)
            data = json.loads(r.stdout)
        except Exception as e:
            data = {"disks": [], "needed": None}
            self.info.setText("The disks could not be listed (%s)." % e)
        self.disks = data.get("disks", [])
        need = data.get("needed")
        for d in self.disks:
            kind = {"usb": "USB disk", "nvme": "NVMe SSD", "sata": "SATA disk", "ata": "disk", "file": "test image"}.get(d["transport"], "disk")
            text = "%s\n%s  -  %s  -  %s" % (d["model"], human(d["size"]), kind, d["path"])
            if not d["usable"]:
                text += "\n" + d["why"]
            it = QListWidgetItem(QIcon.fromTheme("drive-removable-media-usb" if d["removable"] or d["transport"] == "usb"
                                                 else "drive-harddisk"), text)
            it.setData(Qt.ItemDataRole.UserRole, d)
            if not d["usable"]:
                it.setFlags(it.flags() & ~Qt.ItemFlag.ItemIsSelectable & ~Qt.ItemFlag.ItemIsEnabled)
            self.list.addItem(it)
        usable = [d for d in self.disks if d["usable"]]
        if not self.disks:
            self.info.setText("No disk was found. Is the disk connected?")
        elif not usable:
            self.info.setText("None of the disks can be used." + (" Hydra needs at least %s." % human(need) if need else ""))
        else:
            self.info.setText("Hydra needs at least %s." % human(need) if need else "")
        if len(usable) == 1:
            for i in range(self.list.count()):
                if self.list.item(i).data(Qt.ItemDataRole.UserRole)["usable"]:
                    self.list.setCurrentRow(i)
        self.wiz.update_buttons()

    def changed(self, cur, _prev):
        self.confirm.setChecked(False)
        d = self.value()
        if d:
            self.warn_text.setText("Everything on <b>%s (%s)</b> will be deleted." % (d["model"], human(d["size"])))
            self.warn.show()
        else:
            self.warn.hide()
        self.wiz.update_buttons()

    def value(self):
        cur = self.list.currentItem()
        d = cur.data(Qt.ItemDataRole.UserRole) if cur else None
        return d if d and d["usable"] else None

    def ready(self):
        return bool(self.value()) and self.confirm.isChecked()


class AccountPage(Page):
    def __init__(self, wiz):
        super().__init__(wiz)
        self.box.addWidget(title("Who will use this computer?"))
        self.box.addWidget(para("This account is an administrator: it can install programs and change settings. "
                                "You can add accounts for other people later in Settings."))
        g = QGridLayout()
        g.setVerticalSpacing(8)
        g.setHorizontalSpacing(14)
        self.full = QLineEdit(placeholderText="e.g. Anna Smith")
        self.user = QLineEdit(placeholderText="e.g. anna")
        self.pw1 = QLineEdit(echoMode=QLineEdit.EchoMode.Password)
        self.pw2 = QLineEdit(echoMode=QLineEdit.EchoMode.Password)
        self.host = QLineEdit(placeholderText="e.g. anna-pc")
        self.user_edited = self.host_edited = False
        self.msgs = {}
        rows = [("Your name", self.full, "Shown on the login screen."),
                ("User name", self.user, "Short name for logging in: small letters and digits, no spaces."),
                ("Password", self.pw1, ""),
                ("Password again", self.pw2, ""),
                ("Computer name", self.host, "How this computer appears to others on the network.")]
        for r, (label, edit, hint) in enumerate(rows):
            g.addWidget(QLabel(label + ":"), 2 * r, 0)
            g.addWidget(edit, 2 * r, 1)
            m = QLabel(hint)
            m.setObjectName("dim")
            m.setWordWrap(True)
            self.msgs[edit] = (m, hint)
            g.addWidget(m, 2 * r + 1, 1)
        self.box.addLayout(g)
        self.show_pw = QCheckBox("Show the password")
        self.show_pw.toggled.connect(lambda on: [e.setEchoMode(QLineEdit.EchoMode.Normal if on else QLineEdit.EchoMode.Password)
                                                 for e in (self.pw1, self.pw2)])
        self.box.addWidget(self.show_pw)
        self.box.addStretch(1)
        self.full.textChanged.connect(self.full_changed)
        self.user.textEdited.connect(lambda _: setattr(self, "user_edited", True))
        self.host.textEdited.connect(lambda _: setattr(self, "host_edited", True))
        for e in (self.full, self.user, self.pw1, self.pw2, self.host):
            e.textChanged.connect(self.check)
        self.reserved = reserved_names()

    def full_changed(self, text):
        if not self.user_edited:
            self.user.setText(suggest_user(text))
        if not self.host_edited:
            u = self.user.text()
            self.host.setText((u + "-pc") if u else "")

    def set_msg(self, edit, text):
        m, hint = self.msgs[edit]
        m.setText(text or hint)
        m.setObjectName("error" if text else "dim")
        m.style().unpolish(m)
        m.style().polish(m)

    def problems(self):
        p = {}
        u, h = self.user.text(), self.host.text()
        if u and not re.match(r"^[a-z_][a-z0-9_-]{0,31}$", u):
            p[self.user] = "Use only small letters (a-z), digits, - and _; start with a letter."
        elif u in self.reserved:
            p[self.user] = "This name is used by the system. Please choose another one."
        if ":" in self.full.text():
            p[self.full] = "The name cannot contain a colon (:)."
        if self.pw1.text() and len(self.pw1.text()) < 4:
            p[self.pw1] = "Please use at least 4 characters (longer is safer)."
        if self.pw2.text() and self.pw2.text() != self.pw1.text():
            p[self.pw2] = "The two passwords are not the same."
        if h and not re.match(r"^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$", h):
            p[self.host] = "Use only letters, digits and - (not at the start or end), no spaces."
        return p

    def check(self, *_):
        p = self.problems()
        for e in self.msgs:
            self.set_msg(e, p.get(e, ""))
        self.wiz.update_buttons()

    def ready(self):
        return (not self.problems() and all(e.text() for e in (self.full, self.user, self.pw1, self.pw2, self.host))
                and self.pw1.text() == self.pw2.text())


class SummaryPage(Page):
    next_text = "Install"

    def __init__(self, wiz):
        super().__init__(wiz)
        self.box.addWidget(title("Ready to install"))
        self.box.addWidget(para("Please check your choices. Use <b>Back</b> to change something."))
        self.grid = QGridLayout()
        self.grid.setHorizontalSpacing(18)
        self.grid.setVerticalSpacing(8)
        self.grid.setColumnStretch(1, 1)
        self.box.addLayout(self.grid)
        self.box.addSpacing(10)
        self.warn = QLabel()
        self.warn.setObjectName("dangertext")
        self.warn.setWordWrap(True)
        self.box.addWidget(self.warn)
        self.box.addWidget(para("Installing takes about 5 to 20 minutes, depending on the disk. Keep the computer "
                                "plugged in.", dim=True))
        self.box.addStretch(1)

    def enter(self):
        while self.grid.count():
            self.grid.takeAt(0).widget().deleteLater()
        w = self.wiz
        d = w.disk.value()
        rows = [("Language", w.welcome.language()[0]),
                ("Keyboard", w.keyboard.describe()),
                ("Time zone", w.time.value().replace("_", " ")),
                ("Disk", "%s (%s, %s)" % (d["model"], human(d["size"]), d["path"]) if d else "-"),
                ("Your name", w.account.full.text()),
                ("User name", w.account.user.text() + "  (administrator)"),
                ("Computer name", w.account.host.text())]
        for r, (k, v) in enumerate(rows):
            kl = QLabel(k + ":")
            kl.setObjectName("dim")
            self.grid.addWidget(kl, r, 0, Qt.AlignmentFlag.AlignTop)
            vl = QLabel(v)
            vl.setWordWrap(True)
            vl.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
            self.grid.addWidget(vl, r, 1)
        if d:
            self.warn.setText("When you click Install, everything on <b>%s (%s)</b> will be deleted." % (d["model"], human(d["size"])))


class ProgressPage(Page):
