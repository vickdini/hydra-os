def screenshots(app, w, outdir):
    """Saves a picture of every page with sample answers (for Hydra's tests)."""
    os.makedirs(outdir, exist_ok=True)

    def shot(name):
        app.processEvents()
        w.grab().save(os.path.join(outdir, name + ".png"))

    w.show()
    w.welcome.list.setCurrentRow(2)
    shot("1-welcome")
    w.go_next()
    w.keyboard.test.setText("Grüße aus Zürich: z y ä ö ü ß @")
    shot("2-keyboard")
    w.go_next()
    shot("3-timezone")
    w.go_next()
    usable = [i for i in range(w.disk.list.count()) if w.disk.list.item(i).data(Qt.ItemDataRole.UserRole)["usable"]]
    if usable:
        w.disk.list.setCurrentRow(usable[0])
    shot("4-disk")
    w.disk.confirm.setChecked(True)
    shot("4-disk-confirmed")
    w.go_next()
    w.account.full.setText("Anna Schmidt")
    w.account.pw1.setText("secret")
    w.account.pw2.setText("secreT")
    shot("5-account-mismatch")
    w.account.pw2.setText("secret")
    shot("5-account")
    w.go_next()
    shot("6-summary")
    w.progress.set_step(4)
    w.progress.bar.setValue(42)
    w.progress.detail.setText("2.1 GB of 5.0 GB, about 3 min left")
    w.show_page(6)
    shot("7-progress")
    w.done.success(["The computer's start-up list could not be changed from here; Hydra will start through the "
                    "standard start-up path of the disk."])
    w.show_page(7)
    shot("8-finished")
    w.done.failure("What was read back from the disk differs from what was written. The disk may be faulty.",
                   "STEP 1 ...\nERROR What was read back ...")
    w.show_page(7)
    shot("9-failed")


def main():
    app = QApplication(sys.argv[:1])
    app.setApplicationName("hydra-install")
    app.setApplicationDisplayName("Install Hydra")
    app.setDesktopFileName("hydra-install")
    app.setStyleSheet(STYLE)
    w = Wizard()
    if len(sys.argv) == 3 and sys.argv[1] == "--screenshots":
        screenshots(app, w, sys.argv[2])
        return 0
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
