    def set_step(self, n, failed=False):
        for i, (l, s) in enumerate(self.steps):
            if i + 1 < n or (n > len(self.steps)):
                l.setText("<span style='color:#2e9d4b'>&#10004;</span>&nbsp;&nbsp;%s" % s)
            elif i + 1 == n:
                l.setText(("<span style='color:#d4382c'>&#10008;</span>&nbsp;&nbsp;<b>%s</b>" if failed else
                           "<span style='color:palette(highlight)'>&#9654;</span>&nbsp;&nbsp;<b>%s</b>") % s)
            else:
                l.setText("<span style='color:gray'>&#9675;</span>&nbsp;&nbsp;<span style='color:gray'>%s</span>" % s)


class DonePage(Page):
    def __init__(self, wiz):
        super().__init__(wiz)
        self.head = title("")
        self.box.addWidget(self.head)
        self.text = para("")
        self.box.addWidget(self.text)
