class KeyboardPage(Page):
    def __init__(self, wiz):
        super().__init__(wiz)
        self.box.addWidget(title("Keyboard layout"))
        self.box.addWidget(para("Choose the layout of your keyboard. Then type in the test box to check that "
                                "the keys give the right letters, for example Z, Y, Ä, É or @."))
        self.search = QLineEdit()
        self.search.setPlaceholderText("Search for a layout, e.g. German or French")
        self.search.setClearButtonEnabled(True)
        self.search.textChanged.connect(self.filter)
        self.box.addWidget(self.search)
        self.list = QListWidget()
        self.layouts, self.variants = keyboard_layouts()
        for name, desc in self.layouts:
            it = QListWidgetItem("%s" % desc)
            it.setData(Qt.ItemDataRole.UserRole, name)
            it.setToolTip(name)
            self.list.addItem(it)
        self.list.currentItemChanged.connect(self.layout_changed)
        self.box.addWidget(self.list, 1)
        row = QHBoxLayout()
        row.addWidget(QLabel("Variant:"))
        self.variant = QComboBox()
        self.variant.currentIndexChanged.connect(self.apply_live)
        row.addWidget(self.variant, 1)
        self.box.addLayout(row)
        self.test = QLineEdit()
        self.test.setPlaceholderText("Type here to test your keyboard")
        self.box.addWidget(self.test)
        self.note = para("", dim=True)
        self.box.addWidget(self.note)
        self.timer = QTimer(self, singleShot=True, interval=400, timeout=self.apply_now)

    def filter(self, text):
        t = text.lower().strip()
        for i in range(self.list.count()):
            it = self.list.item(i)
            it.setHidden(bool(t) and t not in it.text().lower() and t != it.data(Qt.ItemDataRole.UserRole))

    def select(self, layout):
        for i in range(self.list.count()):
            if self.list.item(i).data(Qt.ItemDataRole.UserRole) == layout:
                self.list.setCurrentRow(i)
                self.list.scrollToItem(self.list.item(i), QAbstractItemView.ScrollHint.PositionAtCenter)
                return

    def layout_changed(self, cur, _prev):
        self.variant.blockSignals(True)
        self.variant.clear()
        self.variant.addItem("Standard", "")
        if cur:
            for name, desc in self.variants.get(cur.data(Qt.ItemDataRole.UserRole), []):
                self.variant.addItem(desc, name)
        self.variant.blockSignals(False)
        self.apply_live()

    def value(self):
        cur = self.list.currentItem()
        return (cur.data(Qt.ItemDataRole.UserRole) if cur else "us"), (self.variant.currentData() or "")

    def describe(self):
        cur = self.list.currentItem()
        v = self.variant.currentText() if self.variant.currentData() else ""
        return (cur.text() if cur else "English (US)") + (" - " + v if v else "")

    def apply_live(self, *_):
        self.timer.start()

    def apply_now(self):
        """Switches this live session to the chosen layout, so the test box shows it."""
        lay, var = self.value()
        if pwd.getpwuid(os.getuid()).pw_name != "live" or not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
            self.note.setText("The test box uses the keyboard layout of this session; the layout you choose "
                              "is used on the new system.")
            return
        cfg = os.path.join(os.path.expanduser("~"), ".config", "kxkbrc")
        try:
            os.makedirs(os.path.dirname(cfg), exist_ok=True)
            with open(cfg, "w") as f:
                f.write("[Layout]\nLayoutList=%s\nVariantList=%s\nUse=true\n" % (lay, var))
            subprocess.run(["dbus-send", "--session", "--type=signal", "/Layouts", "org.kde.keyboard.reloadConfig"],
                           capture_output=True, timeout=5)
            self.note.setText("")
        except (OSError, subprocess.SubprocessError):
            pass


