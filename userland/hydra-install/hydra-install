class Wizard(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Install Hydra")
        if LOGO:
            self.setWindowIcon(QIcon(LOGO))
        self.resize(940, 640)
        central = QWidget()
        self.setCentralWidget(central)
        outer = QHBoxLayout(central)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        side = QFrame()
        side.setObjectName("side")
        side.setFixedWidth(220)
        sl = QVBoxLayout(side)
        sl.setContentsMargins(22, 26, 16, 20)
        logo = QLabel()
        if LOGO:
            logo.setPixmap(QPixmap(LOGO).scaled(96, 96, Qt.AspectRatioMode.KeepAspectRatio,
                                                Qt.TransformationMode.SmoothTransformation))
        logo.setAlignment(Qt.AlignmentFlag.AlignLeft)
        sl.addWidget(logo)
        name = QLabel("Setup")
        name.setObjectName("sidetitle")
        sl.addWidget(name)
        sl.addSpacing(18)
        self.side_labels = []
        for s in STEPS:
            l = QLabel(s)
            l.setObjectName("sidestep")
            self.side_labels.append(l)
            sl.addWidget(l)
        sl.addStretch(1)
        outer.addWidget(side)

        right = QVBoxLayout()
        right.setContentsMargins(0, 0, 0, 0)
        right.setSpacing(0)
        self.stack = QStackedWidget()
        right.addWidget(self.stack, 1)
        foot = QFrame()
        foot.setObjectName("footer")
        fl = QHBoxLayout(foot)
        fl.setContentsMargins(36, 12, 36, 16)
        self.cancel = QPushButton("Cancel")
        self.cancel.clicked.connect(self.close)
        fl.addWidget(self.cancel)
        fl.addStretch(1)
        self.back = QPushButton("Back")
        self.back.clicked.connect(self.go_back)
        self.next = QPushButton("Next")
        self.next.setDefault(True)
        self.next.setObjectName("primary")
        self.next.clicked.connect(self.go_next)
        for b in (self.back, self.next):
            b.setMinimumWidth(110)
            fl.addWidget(b)
        right.addWidget(foot)
        outer.addLayout(right, 1)

        self.welcome = WelcomePage(self)
        self.keyboard = KeyboardPage(self)
        self.time = TimePage(self)
        self.disk = DiskPage(self)
        self.account = AccountPage(self)
        self.summary = SummaryPage(self)
        self.progress = ProgressPage(self)
        self.done = DonePage(self)
        for p in (self.welcome, self.keyboard, self.time, self.disk, self.account, self.summary, self.progress, self.done):
            self.stack.addWidget(p)
        self.proc = None
        self.installing = False
        self.out = ""
        self.error = None
        self.notes = []
        self.language_changed(self.welcome.language(), first=True)
        self.show_page(0)

    def language_changed(self, lang, first=False):
        self.keyboard.select(lang[2])
        tz = live_timezone() if first else ""
        if not (tz and self.time.select(tz)):
            self.time.select(lang[3])

    def show_page(self, i):
        self.stack.setCurrentIndex(i)
        page = self.stack.currentWidget()
        page.enter()
        for n, l in enumerate(self.side_labels):
            l.setProperty("state", "done" if n < i else "current" if n == i else "todo")
            l.style().unpolish(l)
            l.style().polish(l)
        self.update_buttons()

    def update_buttons(self, *_):
        i = self.stack.currentIndex()
        page = self.stack.currentWidget()
        if page is self.progress:
            self.back.hide()
            self.next.hide()
            self.cancel.setEnabled(False)
        elif page is self.done:
            self.back.hide()
            self.cancel.hide()
            self.next.show()
            self.next.setEnabled(True)
            self.next.setText("Restart now" if getattr(page, "ok", False) else "Close")
            if not getattr(page, "ok", False):
                self.back.setText("Try again")
                self.back.show()
        else:
            self.back.show()
            self.back.setText("Back")
            self.back.setEnabled(i > 0)
            self.next.show()
            self.next.setText(page.next_text)
            self.next.setEnabled(page.ready())
            self.cancel.setEnabled(True)
            self.cancel.show()

    def go_back(self):
        if self.stack.currentWidget() is self.done:   # "Try again": back to the disk
            self.disk.loaded = False
            self.show_page(3)
            return
        self.show_page(max(0, self.stack.currentIndex() - 1))

    def go_next(self):
        page = self.stack.currentWidget()
        if page is self.done:
            if getattr(page, "ok", False):
                self.restart()
            QApplication.quit()
            return
        if not page.ready():
            return
        if page is self.summary:
            self.start_install()
            return
        self.show_page(self.stack.currentIndex() + 1)

    # ---- Installing ----

    def request(self):
        lay, var = self.keyboard.value()
        a = self.account
        return {"disk": self.disk.value()["path"],
                "setup": {"user_name": a.user.text(), "full_name": a.full.text().strip(),
                          "password_hash": hash_password(a.pw1.text()), "hostname": a.host.text(),
                          "timezone": self.time.value(), "keyboard_layout": lay, "keyboard_variant": var,
                          "language": self.welcome.language()[1]}}

    def start_install(self):
        try:
            req = json.dumps(self.request())
        except Exception as e:
            QMessageBox.critical(self, "Install Hydra", "Your password could not be prepared (%s)." % e)
            return
        self.installing = True
        self.out, self.error, self.notes = "", None, []
        self.progress.set_step(1)
        self.progress.bar.setValue(0)
        self.progress.detail.setText("")
        self.show_page(6)
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.SeparateChannels)
        self.proc.readyReadStandardOutput.connect(self.read_out)
        self.proc.finished.connect(self.finished)
        self.proc.errorOccurred.connect(self.proc_error)
        if TEST:
            self.proc.start(HELPER, ["install"])
        else:
            self.proc.start("pkexec", [HELPER, "install"])
        self.proc.write(req.encode())
        self.proc.closeWriteChannel()
        self.buf = b""

    def read_out(self):
        self.buf += bytes(self.proc.readAllStandardOutput())
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            line = line.decode(errors="replace")
            self.out += line + "\n"
            kind, _, rest = line.partition(" ")
            if kind == "STEP":
                n, _, _text = rest.partition(" ")
                self.progress.set_step(int(n) if n.isdigit() else 1)
            elif kind == "PROGRESS":
                pct, _, text = rest.partition(" ")
                if pct.isdigit():
                    self.progress.bar.setValue(int(pct))
                self.progress.detail.setText(text)
            elif kind == "NOTE":
                self.notes.append(rest)
            elif kind == "ERROR":
                self.error = rest
            elif kind == "DONE":
                self.progress.set_step(len(INSTALL_STEPS) + 1)

    def proc_error(self, err):
        if err == QProcess.ProcessError.FailedToStart:
            self.error = "The installer's helper could not be started."
            self.finished(-1, None)

    def finished(self, code, _status):
        if not self.installing:
            return
        self.installing = False
        self.read_out()
        err = bytes(self.proc.readAllStandardError()).decode(errors="replace")
        ok = code == 0 and "DONE" in self.out.split() and not self.error
        if ok:
            self.done.success(self.notes)
        else:
            if not self.error:
                if not TEST and code in (126, 127):
                    self.error = "Installing needs an administrator's permission, which was not given. Nothing was changed."
                else:
                    self.error = "The installation stopped unexpectedly (code %s)." % code
            self.progress.set_step(int(self.progress_step()), failed=True)
            self.done.failure(self.error, (self.out + err).strip(), touched=self.progress_step() >= 2)
        self.show_page(7)

    def progress_step(self):
        n = 1
        for line in self.out.splitlines():
            if line.startswith("STEP "):
                p = line.split()
                if len(p) > 1 and p[1].isdigit():
                    n = int(p[1])
        return n

    def restart(self):
        r = subprocess.run(["dbus-send", "--system", "--print-reply", "--dest=org.freedesktop.login1",
                            "/org/freedesktop/login1", "org.freedesktop.login1.Manager.Reboot", "boolean:true"],
                           capture_output=True)
        if r.returncode != 0:
            subprocess.run(["reboot"], capture_output=True)

    def closeEvent(self, ev):
        if self.installing:
            QMessageBox.information(self, "Install Hydra", "Please wait until the installation has finished. "
                                    "Stopping it now would leave the disk unusable.")
            ev.ignore()
            return
        ev.accept()


