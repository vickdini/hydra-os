        self.details.hide()
        self.box.addWidget(self.details, 1)
        self.box.addStretch(1)

    def success(self, notes):
        self.ok = True
        self.head.setText("Hydra is installed")
        self.text.setText("Remove the installation stick, then click <b>Restart now</b>. At its first start the "
                          "computer sets up your account (this takes a minute), then shows the login screen: log "
                          "in with your user name <b>%s</b> and your password." % self.wiz.account.user.text())
