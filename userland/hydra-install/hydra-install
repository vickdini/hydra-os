def title(text):
    l = QLabel(text)
    f = l.font()
    f.setPointSizeF(f.pointSizeF() * 1.9)
    f.setWeight(QFont.Weight.Light)
    l.setFont(f)
    l.setWordWrap(True)
    return l


def para(text, dim=False):
    l = QLabel(text)
    l.setWordWrap(True)
    l.setTextFormat(Qt.TextFormat.RichText)
    if dim:
        l.setObjectName("dim")
    return l


