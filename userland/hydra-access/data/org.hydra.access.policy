<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Hydra</vendor>
  <action id="org.hydra.access.manage">
    <description>Change accounts and access rules</description>
    <message>Changing accounts, family settings or access rules needs an administrator's password.</message>
    <icon_name>preferences-system-privacy</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/hydra-access-helper</annotate>
  </action>
</policyconfig>
