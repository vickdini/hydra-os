+/// Group 16 prototype: a server-side name and attribute cache (path -> struct stat).
+static G16_NAMES: YLock<alloc::collections::BTreeMap<Vec<u8>, [u8; 144]>> = YLock::new(alloc::collections::BTreeMap::new());
+
+/// Group 16 prototype: stat(path, statbuf) answered from the server's cache.
+fn g16_stat(cx: &Cx) -> i64 {
+    let path = match cx.user_cstr(cx.args[1]) {
+        Ok(p) => p,
+        Err(e) => return e,
+    };
+    let st = {
+        let mut m = G16_NAMES.lock();
+        if let Some(st) = m.get(&path) {
+            *st
+        } else {
+            let mut st = [0u8; 144];
+            st[8..16].copy_from_slice(&(m.len() as u64 + 2).to_le_bytes()); // st_ino
+            st[24..28].copy_from_slice(&0o100644u32.to_le_bytes()); // st_mode
+            m.insert(path, st);
+            st
+        }
+    };
+    match cx.copy_out(cx.args[2], &st) {
+        Ok(()) => 0,
+        Err(e) => if e == 0 { EFAULT } else { e },
+    }
+}
