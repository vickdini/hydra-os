+fn g16_kind(fd: u64) -> usize {
+    use crate::fs::fd::FileDescriptor as F;
+    if (fd as i64) < 0 || fd > 1 << 20 {
+        return 0;
+    }
+    crate::task::with_current_fds_mut(|fds| match fds.get(fd as usize) {
+        None => 0,
+        Some(F::Vnode(f)) => {
+            if f.try_lock().map(|g| g.is_dir).unwrap_or(false) {
+                2
+            } else {
+                1
+            }
+        }
+        Some(F::File { .. }) => 3,
+        Some(F::PipeRead(_)) | Some(F::PipeWrite(_)) => 4,
+        Some(F::Socket(_)) | Some(F::Unix(_)) => 5,
+        Some(F::Inet(_)) => 6,
+        Some(F::Device(d)) => {
+            if d.as_server().is_some() {
+                7
+            } else {
+                8
+            }
+        }
+        Some(F::ConsoleIn) | Some(F::ConsoleOut) | Some(F::ConsoleErr) | Some(F::Pty(_)) => 9,
+        Some(F::MemFd { .. }) => 11,
+        Some(_) => 10,
+    })
+}
+
+fn g16_pclass(ptr: u64) -> usize {
+    match super::vfs::user_cstr(ptr) {
+        Err(_) => 8,
+        Ok(p) if p.is_empty() => 7,
+        Ok(p) if p[0] != b'/' => 6,
+        Ok(p) => {
+            let first = p[1..].split(|&b| b == b'/').next().unwrap_or(b"");
+            match first {
+                b"proc" => 0,
+                b"sys" => 1,
+                b"dev" => 2,
+                b"run" => 3,
+                b"tmp" => 4,
+                _ => 5,
+            }
+        }
+    }
+}
+
+/// Classifies one call while profiling (called before it runs).
+pub fn g16_classify(nr: u64, a: [u64; 6]) {
+    // fstatat/statx with an empty path (AT_EMPTY_PATH) are descriptor calls
+    let empty_at = |flags: u64, ptr: u64| flags & 0x1000 != 0 && matches!(super::vfs::user_cstr(ptr), Ok(p) if p.is_empty());
+    let fd_call = match nr {
+        262 => empty_at(a[3], a[1]),
+        332 => empty_at(a[2], a[1]),
+        // mmap of a descriptor (not MAP_ANONYMOUS)
+        9 => a[4] as i64 >= 0 && a[3] & 0x20 == 0,
+        _ => true,
+    };
+    if fd_call {
+        if let Some(i) = G16_FD_NRS.iter().position(|&n| n == nr) {
+            G16_FD[i][g16_kind(if nr == 9 { a[4] } else { a[0] })].fetch_add(1, Relaxed);
+            return;
+        }
+    }
+    if let Some(i) = G16_PATH_NRS.iter().position(|&n| n == nr) {
+        let at = matches!(nr, 257 | 437 | 262 | 332 | 269 | 439 | 267 | 322 | 258 | 263 | 264 | 316 | 268 | 260 | 280);
+        let ptr = match nr {
+            266 => a[2], // symlinkat(target, dirfd, linkpath)
+            88 => a[1],  // symlink(target, linkpath)
+            _ if at => a[1],
+            _ => a[0],
+        };
+        G16_PATH[i][g16_pclass(ptr)].fetch_add(1, Relaxed);
+    }
+}
+
+fn g16_show() {
+    let c = |i: usize, k: usize| G16_CACHE[i][k].load(Relaxed);
+    crate::println!("[g16] cache names hit {} miss {} attrs hit {} miss {} links hit {} miss {}", c(0, 0), c(0, 1), c(1, 0), c(1, 1), c(2, 0), c(2, 1));
+    for (i, nr) in G16_FD_NRS.iter().enumerate() {
+        let v: alloc::vec::Vec<u64> = G16_FD[i].iter().map(|x| x.load(Relaxed)).collect();
+        if v.iter().sum::<u64>() == 0 {
+            continue;
+        }
+        let mut s = alloc::string::String::new();
+        for (k, n) in v.iter().enumerate() {
+            if *n > 0 {
+                s.push_str(&alloc::format!(" {}={}", G16_KIND_NAMES[k], n));
+            }
+        }
+        crate::println!("[g16] fd nr {}{}", nr, s);
+    }
+    for (i, nr) in G16_PATH_NRS.iter().enumerate() {
+        let v: alloc::vec::Vec<u64> = G16_PATH[i].iter().map(|x| x.load(Relaxed)).collect();
+        if v.iter().sum::<u64>() == 0 {
+            continue;
+        }
+        let mut s = alloc::string::String::new();
+        for (k, n) in v.iter().enumerate() {
+            if *n > 0 {
+                s.push_str(&alloc::format!(" {}={}", G16_PCLASS_NAMES[k], n));
+            }
+        }
+        crate::println!("[g16] path nr {}{}", nr, s);
+    }
+}
+
+fn g16_reset() {
+    for r in G16_FD.iter() {
+        for x in r.iter() {
+            x.store(0, Relaxed);
+        }
+    }
+    for r in G16_PATH.iter() {
+        for x in r.iter() {
+            x.store(0, Relaxed);
+        }
+    }
+    for r in G16_CACHE.iter() {
+        for x in r.iter() {
+            x.store(0, Relaxed);
+        }
+    }
+}
